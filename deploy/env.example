# Settings for the three abf-platform services and for Caddy, one file for all.
# Copy this file to ~/.config/abf-platform/env and make it readable by you only:
#   chmod 600 ~/.config/abf-platform/env
# On a desktop in WSL, first read the paragraph marked 重要 in docs/OPERATIONS.md, section "Desktop platform in WSL（桌機）": delete the ABF_PLATFORM_DB line, never invent a data folder.
# Then replace every <...> below. The systemd units read it (EnvironmentFile=) and so does
# Caddy (caddy run --envfile).

# The address people and Claude connectors use. Must be https.
ABF_PUBLIC_URL=https://<your-domain>

# Optional: show RStudio inside the downstream page of a succeeded run. Only a loopback address with a port and nothing after it
# (http://127.0.0.1:<port> or http://localhost:<port>) is accepted, and `abf-platform web` refuses to start with anything else. It is the
# address on the computer of the person who looks at the page; the platform never connects to it. The port must not be 8787 to 8789 (the
# platform's own). deploy/systemd/abf-rstudio.service.in takes its port from this line, so the port is written here once. Leave the line
# out, or empty, and the page is as it was. This is one value for the whole deployment and it reaches every user's downstream page (each
# person's browser is sent to the port on their own computer), so set it only for a deployment with one user.
# See docs/OPERATIONS.md, "RStudio in the downstream page".
# ABF_STUDIO_URL=http://127.0.0.1:8790

# Where the databases live. Optional: leave the line out to use the default
# (${XDG_DATA_HOME:-~/.local/share}/abf-platform/index.db). See docs/OPERATIONS.md, section 4.
ABF_PLATFORM_DB=<data-folder>/index.db

# What Caddy listens on.
#   On a rented server, Caddy faces the internet and gets the certificate itself:
#       ABF_SITE_ADDRESS=<your-domain>
#   On a desktop behind Tailscale Funnel, Caddy listens on this machine only (plain http;
#   Funnel adds the https):
#       ABF_SITE_ADDRESS=http://127.0.0.1:8080
ABF_SITE_ADDRESS=<your-domain>

# Tokens do not belong in this file or in any file. A personal access token is made with
# `abf-platform pat new` and shown once; copy it from the terminal at that moment.
