# Settings for the three abf-platform services and for Caddy, one file for all.
# Copy this file to ~/.config/abf-platform/env and make it readable by you only:
#   chmod 600 ~/.config/abf-platform/env
# Then replace every <...> below. The systemd units read it (EnvironmentFile=) and so does
# Caddy (caddy run --envfile).

# The address people and Claude connectors use. Must be https.
ABF_PUBLIC_URL=https://<your-domain>

# Where the databases live. Optional: leave the line out to use the default
# (${XDG_DATA_HOME:-~/.local/share}/abf-platform/index.db). See docs/OPERATIONS.md, section 4.
ABF_PLATFORM_DB=<data-folder>/index.db

# What Caddy listens on.
#   On a rented server, Caddy faces the internet and gets the certificate itself:
#       ABF_SITE_ADDRESS=<your-domain>
#   On a desktop behind Tailscale Funnel, Caddy listens on this machine only (plain http;
#   Funnel adds the https):
#       ABF_SITE_ADDRESS=http://127.0.0.1:8080
ABF_SITE_ADDRESS=<your-domain>

# Tokens do not belong in this file or in any file. A personal access token is made with
# `abf-platform pat new` and shown once; copy it from the terminal at that moment.
