# abf-platform serve, one of the three processes of one lab's platform.
# Install: see docs/OPERATIONS.md, "Hosting one lab". Replace <venv> with the folder (under
# your home) of the virtual environment that has abf-platform installed. No token, password or
# key goes into this file; the settings come from the env file named below.
[Unit]
Description=abf-platform serve

[Service]
EnvironmentFile=%h/.config/abf-platform/env
ExecStart=%h/<venv>/bin/abf-platform serve --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
