# abf-platform web, one of the three processes of one lab's platform.
# Install: see docs/OPERATIONS.md, "Hosting one lab". Replace <venv> with the folder (under
# your home) of the virtual environment that has abf-platform installed. No token, password or
# key goes into this file; the settings come from the env file named below.
[Unit]
Description=abf-platform web

[Service]
EnvironmentFile=%h/.config/abf-platform/env
ExecStart=%h/<venv>/bin/abf-platform web --host 127.0.0.1 --port 8789 --public-url ${ABF_PUBLIC_URL}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
