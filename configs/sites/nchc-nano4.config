// NCHC nano4 - fallback when the national-HPC site modules are absent. Plain Slurm; unlike Taiwania-3
// (nchc.config) there is no box table to map onto: the ngs partition takes the request as asked.
// Override the partition with SLURM_PARTITION; the account comes from SLURM_ACCOUNT (never written here).
process {
    executor       = 'slurm'
    queue          = System.getenv('SLURM_PARTITION') ?: 'ngs'
    clusterOptions = "-A ${SLURM_ACCOUNT}"
    resourceLimits = [cpus: 56, memory: 372.GB, time: 48.h]
}

singularity {
    enabled    = true
    autoMounts = true
}
