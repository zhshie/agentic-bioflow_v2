// NCHC Taiwania-3 - resource mapping for the Seqera compute environment.
//
// The one thing that makes this cluster different from every institutional
// config upstream: NCHC's QOS enforces a LOWER bound per partition, and for
// most partitions MinTRES == MaxTRESPerJob. A partition is a fixed-size box,
// not a range. Ask for less than the box and the job never schedules - it sits
// forever with QOSMinCpuNotSatisfied / QOSMinMemory while hundreds of CPUs sit
// idle, and nothing reports an error. Platform still shows the run as RUNNING.
//
//   $ sacctmgr -nP show qos format=Name,MinTRES,MaxTRESPerJob
//   ngs7g    cpu=1,mem=7G     cpu=1,mem=7G
//   ngs13g   cpu=2,mem=13G    cpu=2,mem=13G
//   ...
//
// Nextflow gives us `resourceLimits` for the ceiling but has no equivalent for
// the floor, so this file supplies it. The mapping is done on the COMPOSED
// request (task.cpus / task.memory / task.time), never on label names: nf-core
// labels are partial and stackable - process_long sets only time,
// process_low_memory sets only memory, process_gpu sets neither - and a process
// may carry two of them. Mapping label names would also mean maintaining a
// table that goes stale the moment a pipeline adds a label, which is exactly
// what happened between rnaseq 3.14 (six labels) and 3.26 (which added
// process_low_memory at 1.GB, below every partition minimum here).
//
// Dynamic `queue` / `clusterOptions` closures are the established nf-core
// idiom for this - see conf/nci_gadi.config and conf/vsc_kul_uhasselt.config.

// Boxes, smallest first. `mem` is the QOS minimum in GB; `maxHours` is the
// partition time limit, 0 meaning unlimited.
def NCHC_BOXES = [
    [ queue: 'ngs7G',   cpus: 1,  mem: 7,   maxHours: 48 ],
    [ queue: 'ngs13G',  cpus: 2,  mem: 13,  maxHours: 48 ],
    [ queue: 'ngs26G',  cpus: 4,  mem: 26,  maxHours: 96 ],
    [ queue: 'ngs53G',  cpus: 8,  mem: 53,  maxHours: 96 ],
    [ queue: 'ngs92G',  cpus: 14, mem: 92,  maxHours: 0  ],
    [ queue: 'ngs186G', cpus: 28, mem: 175, maxHours: 0  ],
    [ queue: 'ngs372G', cpus: 56, mem: 350, maxHours: 0  ],
]

// Smallest box that satisfies all three requests. Falls back to the largest
// box rather than returning null: an oversized request is capped by
// resourceLimits before it reaches here, so this only guards against a request
// that slipped past.
def nchcBox = { reqCpus, reqMemGb, reqHours ->
    NCHC_BOXES.find { b ->
        b.cpus >= reqCpus &&
        b.mem  >= reqMemGb &&
        ( b.maxHours == 0 || b.maxHours >= reqHours )
    } ?: NCHC_BOXES[-1]
}

process {
    executor = 'slurm'

    // Ceiling. Must be >= the largest box; setting it lower silently shrinks a
    // large request into a box that then fails its own QOS minimum.
    resourceLimits = [ cpus: 56, memory: 350.GB, time: 96.h ]

    // Floor. Nextflow emits `-c`, `--mem` and `-p` from the directives above,
    // then appends clusterOptions LAST (SlurmExecutor.getDirectives calls
    // addClusterOptionsDirective at the end), so these values win - sbatch
    // takes the last occurrence of a repeated option. Note Nextflow omits `-c`
    // entirely when cpus == 1, which is why `-c` is always stated here.
    errorStrategy = 'retry'
    maxRetries    = 1
    // Deliberately no task.attempt multiplier on cpus/memory: doubling a
    // request lands it between two boxes, and the retry would strand exactly
    // the way the original request did. A genuine OOM needs its label moved up
    // a tier by hand.
}

// These two MUST live in a selector, not in the plain `process` scope above.
//
// Seqera Platform appends `process.queue = '<the compute environment's compute
// queue field>'` to the end of the generated config, after everything this file
// contributes. A plain `process.queue` here is the same precedence level, so
// the later assignment simply wins and every task goes to that one queue while
// clusterOptions still carries the right box - producing exactly the silent
// QOSMin stall this file exists to prevent. Selectors outrank the generic
// scope regardless of order, so `withName: '.*'` survives the injection.
//
// It also outranks any withName block a pipeline defines, because this file is
// merged after the pipeline's own config.
process {
    withName: '.*' {
        queue = {
            def b = nchcBox(
                task.cpus ?: 1,
                (task.memory ? task.memory.toGiga() : 1) as int,
                (task.time   ? task.time.toHours()  : 1) as int )
            b.queue
        }
        clusterOptions = {
            def b = nchcBox(
                task.cpus ?: 1,
                (task.memory ? task.memory.toGiga() : 1) as int,
                (task.time   ? task.time.toHours()  : 1) as int )
            // Read from the environment, not params: nf-core validates params
            // against nextflow_schema.json and an unknown one produces a
            // warning on every run.
            def acct = System.getenv('NCHC_SLURM_ACCOUNT') ?: 'MST109178'
            // -p is repeated here on purpose. One closure owns all three values
            // so the partition can never drift from the -c/--mem chosen for it,
            // whatever else sets `queue`. sbatch takes the last occurrence of a
            // repeated option and clusterOptions is emitted last, so this is the
            // value that counts.
            "-A ${acct} -p ${b.queue} -c ${b.cpus} --mem=${b.mem}G"
        }
    }
}

singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/work/u9613010/.singularity_cache/'
    pullTimeout = '60m'
}
