// Generated by abf-platform compose (pipeline demo-qc v1); do not edit by hand.
manifest {
    name = 'demo-qc'
    version = '0.1.0'
}

process {
    withName: 'FASTQC' {
        ext.args = '--quiet'
    }
}

// added by the platform at launch: every process copies its outputs to <outdir>/<process name in small letters>
process.publishDir = [
    path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
    mode: 'copy'
]
