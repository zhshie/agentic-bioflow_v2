{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|.*[Ss]hell.*|.*[Pp]ower[Ss]hell.*|.*[Pp]wsh.*|.*[Tt]erminal.*|.*[Cc]md.*|.*[Ee]xec.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/confirm_launch.sh",
            "onFailure": "block",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/confirm_cleanup.sh",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*([Ss]eqera|[Tt]ower).*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/confirm_launch.sh",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/confirm_launch.sh",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|.*[Ss]hell.*|.*[Pp]ower[Ss]hell.*|.*[Pp]wsh.*|.*[Tt]erminal.*|.*[Cc]md.*|.*[Ee]xec.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard_plugin_files.sh",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|.*[Ss]hell.*|.*[Pp]ower[Ss]hell.*|.*[Pp]wsh.*|.*[Tt]erminal.*|.*[Cc]md.*|.*[Ee]xec.*|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/confirm_walkthrough.sh",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard_plugin_files.sh",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/next_step.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/plugin_intro.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/plugin_intro.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
